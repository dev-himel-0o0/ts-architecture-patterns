{
  "name": "ts-architecture-patterns",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript runtime patterns, strict type-level utilities, and domain modeling primitives.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml}\"",
    "test": "vitest run --typecheck",
    "test:watch": "vitest --typecheck",
    "build": "tsc -p tsconfig.build.json",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "typescript",
    "type-safety",
    "architecture",
    "design-patterns",
    "domain-modeling"
  ],
  "author": "Shahadat Himel",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.1.0"
  }
}
